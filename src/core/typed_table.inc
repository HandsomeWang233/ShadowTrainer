int Core::save_table_v2(const wchar_t* path){return guarded([&]{if(!path||!*path||std::wcslen(path)>32700)return fail(CE_INVALID_ARGUMENT,L"Invalid CT destination path.");std::vector<StoredRecord> records;TableExtra extra;uint64_t revision;{std::lock_guard lock(impl_->state_mutex);if(impl_->stopped.load())return impl_->stopped_error();records=impl_->address_records;extra=impl_->table_extra;revision=impl_->revision;}if(records.size()>max_table_records)return table_error(L"CT supports at most 10000 records.");ComScope com;if(!com.valid())return int(CE_INTERNAL_ERROR);ComPointer<IStream> stream;if(FAILED(CreateStreamOnHGlobal(nullptr,TRUE,stream.put())))return int(CE_INTERNAL_ERROR);int status=serialize_table_v2(records,extra,stream.value);if(status)return status;STATSTG stat{};if(FAILED(stream->Stat(&stat,STATFLAG_NONAME)))return int(CE_IO_ERROR);if(stat.cbSize.QuadPart>max_table_bytes)return table_error(L"CT exceeds 8 MiB.");LARGE_INTEGER zero{};if(FAILED(stream->Seek(zero,STREAM_SEEK_SET,nullptr)))return int(CE_IO_ERROR);TemporaryFile file;status=create_temporary(std::wstring(path)+L".ce-save-",file,false);if(status)return status;std::array<uint8_t,65536> buffer;uint64_t left=stat.cbSize.QuadPart;while(left){ULONG wanted=ULONG((std::min)(left,uint64_t(buffer.size()))),got=0;if(FAILED(stream->Read(buffer.data(),wanted,&got))||got!=wanted||!write_exact(file.handle.value,buffer.data(),got))return int(CE_IO_ERROR);left-=got;}if(!FlushFileBuffers(file.handle.value))return int(CE_IO_ERROR);file.handle.close();std::lock_guard lock(impl_->state_mutex);if(impl_->stopped.load())return impl_->stopped_error();if(revision!=impl_->revision)return fail(CE_BUSY,L"Records changed during CT export.");if(!MoveFileExW(file.path.c_str(),path,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))return win_fail(L"Cannot atomically replace CT destination");file.path.clear();return int(CE_OK);});}
