// Preserved nodes come back from the parsed tree: equal to the source, not
// byte-identical.
int write_node(IXmlWriter* writer,const XmlNode& node);
// XmlLite rewrites LF to CRLF inside text nodes while auto-indenting, which would
// silently edit every preserved script body. Suspending indentation around preserved
// subtrees keeps the text verbatim; the surrounding table stays readable.
